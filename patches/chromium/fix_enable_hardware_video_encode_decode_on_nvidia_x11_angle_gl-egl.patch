 namespace gl {
 
+namespace {
+EGLConfig ChooseWindowConfig(EGLDisplay display,
+                             x11::VisualId visual_id,
+                             uint8_t depth) {
+  const std::array<EGLint, 2> renderable_types = {EGL_OPENGL_ES3_BIT,
+                                                  EGL_OPENGL_ES2_BIT};
+  const std::array<EGLint, 2> alpha_sizes = {
+      depth == 32 ? 8 : 0,
+      0,
+  };
+
+  for (EGLint renderable_type : renderable_types) {
+    for (EGLint alpha_size : alpha_sizes) {
+      if (depth != 32 && alpha_size != 0)
+        continue;
+
+      std::array<EGLint, 15> config_attribs = {
+          EGL_BUFFER_SIZE,  static_cast<EGLint>(depth),
+          EGL_ALPHA_SIZE,   alpha_size,
+          EGL_BLUE_SIZE,    8,
+          EGL_GREEN_SIZE,   8,
+          EGL_RED_SIZE,     8,
+          EGL_RENDERABLE_TYPE,
+          renderable_type,
+          EGL_SURFACE_TYPE,
+          EGL_WINDOW_BIT | EGL_PBUFFER_BIT,
+          EGL_NONE,
+      };
+
+      EGLint num_configs = 0;
+      if (!eglChooseConfig(display, config_attribs.data(), nullptr, 0,
+                           &num_configs)) {
+        LOG(ERROR) << "eglChooseConfig failed with error "
+                   << ui::GetLastEGLErrorString();
+        return nullptr;
+      }
+      if (!num_configs)
+        continue;
+
+      std::vector<EGLConfig> configs(num_configs);
+      if (!eglChooseConfig(display, config_attribs.data(), configs.data(),
+                           num_configs, &num_configs)) {
+        LOG(ERROR) << "eglChooseConfig failed with error "
+                   << ui::GetLastEGLErrorString();
+        return nullptr;
+      }
+
+      for (EGLConfig config : configs) {
+        EGLint config_depth = 0;
+        EGLint config_visual_id = 0;
+        if (!eglGetConfigAttrib(display, config, EGL_BUFFER_SIZE,
+                                &config_depth) ||
+            !eglGetConfigAttrib(display, config, EGL_NATIVE_VISUAL_ID,
+                                &config_visual_id)) {
+          LOG(ERROR) << "eglGetConfigAttrib failed with error "
+                     << ui::GetLastEGLErrorString();
+          return nullptr;
+        }
+        if (config_depth == depth &&
+            config_visual_id == static_cast<EGLint>(visual_id)) {
+          return config;
+        }
+      }
+    }
+  }
+
+  return nullptr;
+}
