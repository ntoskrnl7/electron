+
 NativeViewGLSurfaceEGLX11::NativeViewGLSurfaceEGLX11(GLDisplayEGL* display,
                                                      x11::Window window)
     : NativeViewGLSurfaceEGL(display, static_cast<uint32_t>(window), nullptr) {}
 
+EGLConfig NativeViewGLSurfaceEGLX11::GetConfig() {
+  if (config_)
+    return config_;
+
+  DCHECK(window_);
+  auto* connection = GetXNativeConnection();
+  auto window = static_cast<x11::Window>(window_);
+  auto attributes = connection->GetWindowAttributes(window).Sync();
+  if (!attributes) {
+    LOG(ERROR) << "GetWindowAttributes failed for window "
+               << static_cast<uint32_t>(window)
+               << "; falling back to generic EGL config selection.";
+    return NativeViewGLSurfaceEGL::GetConfig();
+  }
+
+  uint8_t depth = 0;
+  if (!connection->GetOrCreateVisualManager().GetVisualInfo(
+          attributes->visual, &depth, nullptr, nullptr)) {
+    LOG(ERROR) << "GetVisualInfo failed for visual "
+               << static_cast<uint32_t>(attributes->visual)
+               << "; falling back to generic EGL config selection.";
+    return NativeViewGLSurfaceEGL::GetConfig();
+  }
+
+  config_ = ChooseWindowConfig(display_->GetDisplay(), attributes->visual, depth);
+  if (!config_) {
+    LOG(ERROR) << "NativeViewGLSurfaceEGLX11::GetConfig failed for visual "
+               << static_cast<uint32_t>(attributes->visual)
+               << " depth " << static_cast<int>(depth) << ".";
+  }
+  return config_;
+}
